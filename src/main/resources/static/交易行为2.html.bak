<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>交易行为 AI 分析</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: '#0F172A',
            secondary: '#2563EB',
            accent: '#10B981',
            light: '#F8FAFC',
          },
          fontFamily: {
            sans: ['Inter', 'system-ui', 'sans-serif'],
          },
        },
      }
    }
  </script>
  <style type="text/tailwindcss">
    @layer utilities {
      .hash-text {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
    }
  </style>
</head>
<body class="bg-slate-50 font-sans text-primary">
<header class="sticky top-0 z-50 border-b border-slate-200 bg-white/90 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4">
    <a href="index.html" class="flex items-center gap-2">
      <i class="fa-solid fa-shield-halved text-2xl text-secondary"></i>
      <span class="text-xl font-bold">ChainAudit<span class="text-secondary">Pro</span></span>
    </a>
    <nav class="hidden items-center gap-6 text-sm font-medium text-slate-600 md:flex">
      <a href="index.html" class="hover:text-secondary">首页</a>
      <a href="交易行为.html" class="hover:text-secondary">原交易行为页</a>
      <a href="交易行为2.html" class="text-secondary">AI 分析视图</a>
    </nav>
    <a href="index.html#monitoring" class="inline-flex items-center gap-2 rounded-lg bg-secondary px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700">
      <i class="fa-solid fa-chart-line"></i>
      安全态势
    </a>
  </div>
</header>

<section class="border-b border-slate-800 bg-[#0B1120]">
  <div class="mx-auto grid max-w-7xl gap-8 px-4 py-10 lg:grid-cols-[1.35fr_0.65fr] lg:items-end">
    <div>
      <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-cyan-300/20 bg-cyan-300/10 px-3 py-1 text-sm font-medium text-cyan-100">
        <i class="fa-solid fa-brain"></i>
        按需启动大模型交易行为分析
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-white md:text-4xl">交易行为 AI 分析视图</h1>
      <p class="mt-4 max-w-3xl leading-7 text-slate-300">
        展示 ETH-Malicious-TX-Monitor 捕获的交易样本。页面加载时只展示基础交易信息，点击每行的 go 后才调用后端大模型接口生成分析结果。
      </p>
    </div>
    <div class="grid grid-cols-2 gap-3">
      <div class="rounded-lg border border-slate-700 bg-white/5 p-4">
        <div class="text-sm text-slate-400">样本记录</div>
        <div class="mt-1 text-3xl font-bold text-white"><span id="recordCount">0</span><span class="ml-1 text-sm text-slate-500">条</span></div>
      </div>
      <div class="rounded-lg border border-slate-700 bg-white/5 p-4">
        <div class="text-sm text-slate-400">数据刷新</div>
        <div class="mt-1 text-3xl font-bold text-emerald-300">15<span class="ml-1 text-sm text-slate-500">分钟</span></div>
      </div>
    </div>
  </div>
</section>

<main class="mx-auto max-w-7xl px-4 py-8">
  <section class="mb-6 grid gap-4 md:grid-cols-3">
    <div class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-center justify-between">
        <span class="text-sm font-medium text-slate-500">展示记录</span>
        <i class="fa-solid fa-table-list text-blue-500"></i>
      </div>
      <div class="mt-3 text-3xl font-bold text-slate-900" id="sampleCount">0</div>
    </div>
    <div class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-center justify-between">
        <span class="text-sm font-medium text-slate-500">涉及地址</span>
        <i class="fa-solid fa-fingerprint text-emerald-500"></i>
      </div>
      <div class="mt-3 text-3xl font-bold text-slate-900" id="addressCount">0</div>
    </div>
    <div class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-center justify-between">
        <span class="text-sm font-medium text-slate-500">最近更新</span>
        <i class="fa-solid fa-clock-rotate-left text-amber-500"></i>
      </div>
      <div class="mt-3 text-base font-bold text-slate-900" id="refreshedAt">-</div>
    </div>
  </section>

  <section class="mb-6 grid gap-4 lg:grid-cols-[1fr_360px]">
    <div class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
      <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
        <div>
          <h2 class="text-xl font-bold text-slate-900">交易行为队列</h2>
          <p class="mt-1 text-sm text-slate-500">数据源：<span id="sourcePath" class="font-mono text-slate-700">-</span></p>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row">
          <div class="relative">
            <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-sm text-slate-400"></i>
            <input id="searchInput" type="search" placeholder="搜索 hash / address" class="w-full rounded-lg border border-slate-300 bg-white py-2 pl-9 pr-3 text-sm outline-none focus:border-secondary sm:w-64">
          </div>
          <button id="reloadBtn" class="inline-flex items-center justify-center gap-2 rounded-lg bg-secondary px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700">
            <i class="fa-solid fa-rotate-right"></i>
            刷新
          </button>
        </div>
      </div>
    </div>
    <div class="rounded-lg border border-blue-100 bg-blue-50 p-4 text-sm text-slate-700">
      <div class="mb-2 flex items-center gap-2 font-semibold text-blue-800">
        <i class="fa-solid fa-circle-info"></i>
        按需分析
      </div>
      <p class="leading-6">点击 ANALYSIS RESULT 列中的 go 后，后端才会调用 deepseek-v4-pro 对该交易样本做初步分析。未点击的行不会消耗大模型 token。</p>
    </div>
  </section>

  <div id="statusBanner" class="hidden mb-4 rounded-lg border px-4 py-3 text-sm"></div>

  <section class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
    <div class="hidden grid-cols-[170px_110px_130px_minmax(0,1fr)_minmax(0,1fr)_150px] items-center gap-4 border-b border-slate-200 bg-slate-50 px-4 py-3 text-xs font-semibold uppercase tracking-wide text-slate-500 xl:grid">
      <div>Txn Hash</div>
      <div>Block</div>
      <div>Age</div>
      <div>From</div>
      <div>To</div>
      <div>ANALYSIS RESULT</div>
    </div>
    <div id="recordList" class="divide-y divide-slate-100">
      <div class="py-12 text-center text-slate-500">正在加载交易行为数据...</div>
    </div>
  </section>
</main>

<script>
  const recordList = document.getElementById('recordList');
  const recordCount = document.getElementById('recordCount');
  const sampleCount = document.getElementById('sampleCount');
  const addressCount = document.getElementById('addressCount');
  const sourcePath = document.getElementById('sourcePath');
  const refreshedAt = document.getElementById('refreshedAt');
  const reloadBtn = document.getElementById('reloadBtn');
  const statusBanner = document.getElementById('statusBanner');
  const searchInput = document.getElementById('searchInput');
  let currentRecords = [];

  document.addEventListener('DOMContentLoaded', loadRecords);
  reloadBtn.addEventListener('click', () => loadRecords(true));
  searchInput.addEventListener('input', renderFilteredRecords);

  async function loadRecords(forceRefresh = false) {
    reloadBtn.disabled = true;
    reloadBtn.classList.add('opacity-60', 'cursor-not-allowed');
    try {
      const response = await fetch(forceRefresh ? '/records/refresh' : '/records/latest', {
        method: forceRefresh ? 'POST' : 'GET',
        cache: 'no-store',
      });
      if (!response.ok) throw new Error('HTTP ' + response.status);
      const data = await response.json();
      currentRecords = (data.records || []).map((item) => ({
        ...item,
        analysisState: 'idle',
        analysisText: '',
        fundFlowState: 'idle',
        fundFlowData: null,
        fundFlowMessage: '',
      }));
      renderMeta(data, currentRecords);
      renderFilteredRecords();
      data.status === 'ok' ? hideBanner() : showBanner(data.message || '数据状态异常', data.status === 'error' ? 'error' : 'warn');
    } catch (error) {
      currentRecords = [];
      renderMeta({}, []);
      recordList.innerHTML = '<div class="py-12 text-center text-red-500">无法连接交易记录接口</div>';
      showBanner('交易记录加载失败：' + error.message, 'error');
    } finally {
      reloadBtn.disabled = false;
      reloadBtn.classList.remove('opacity-60', 'cursor-not-allowed');
    }
  }

  function renderMeta(data, records) {
    const uniqueAddresses = new Set();
    records.forEach((item) => {
      [item.from, item.to].filter(Boolean).forEach((address) => uniqueAddresses.add(address));
    });

    recordCount.textContent = records.length;
    sampleCount.textContent = records.length;
    addressCount.textContent = uniqueAddresses.size;
    sourcePath.textContent = data.sourcePath || '-';
    refreshedAt.textContent = formatDateTime(data.refreshedAt);
  }

  function renderFilteredRecords() {
    const keyword = searchInput.value.trim().toLowerCase();
    const records = currentRecords.filter((item) => {
      return !keyword || [item.txHash, item.from, item.to].some((value) => String(value || '').toLowerCase().includes(keyword));
    });
    renderRecords(records);
  }

  function renderRecords(records) {
    if (!records.length) {
      recordList.innerHTML = '<div class="py-12 text-center text-slate-500">暂无匹配记录</div>';
      return;
    }

    recordList.innerHTML = records.map((item) => `
      <div class="transaction-row" data-tx-hash="${escapeAttr(item.txHash)}">
        <div class="grid grid-cols-1 gap-3 px-4 py-4 text-sm transition hover:bg-slate-50 xl:grid-cols-[170px_110px_130px_minmax(0,1fr)_minmax(0,1fr)_150px] xl:items-center xl:gap-4">
          <div class="min-w-0">
            <div class="mb-1 text-xs text-slate-500 xl:hidden">Txn Hash</div>
            <a href="${escapeAttr(item.txUrl)}" target="_blank" class="block font-mono text-secondary hover:underline hash-text" title="${escapeAttr(item.txHash)}">${shortHash(item.txHash)}</a>
          </div>
          <div>
            <div class="mb-1 text-xs text-slate-500 xl:hidden">Block</div>
            <a href="https://etherscan.io/block/${escapeAttr(item.blockNum || '')}" target="_blank" class="text-secondary hover:underline">${escapeHtml(item.blockNum || '-')}</a>
          </div>
          <div>
            <div class="mb-1 text-xs text-slate-500 xl:hidden">Age</div>
            <span class="text-slate-700">${formatAge(item.detectTime)}</span>
          </div>
          <div class="min-w-0">
            <div class="mb-1 text-xs text-slate-500 xl:hidden">From</div>
            ${addressLink(item.from, item.fromUrl)}
          </div>
          <div class="min-w-0">
            <div class="mb-1 text-xs text-slate-500 xl:hidden">To</div>
            ${addressLink(item.to, item.toUrl)}
          </div>
          <div>
            <div class="mb-1 text-xs text-slate-500 xl:hidden">ANALYSIS RESULT</div>
            ${analysisControl(item)}
          </div>
        </div>
        ${analysisPanel(item)}
      </div>
    `).join('');

    document.querySelectorAll('[data-analyze-tx]').forEach((button) => {
      button.addEventListener('click', () => analyzeRecord(button.dataset.analyzeTx));
    });
    bindFundFlowButtons();
  }

  function analysisControl(item) {
    if (item.fundFlowState === 'loading') {
      return `
        <span class="inline-flex items-center gap-2 rounded-lg border border-cyan-200 bg-cyan-50 px-3 py-2 text-xs font-semibold text-cyan-700">
          <i class="fa-solid fa-spinner animate-spin"></i>
          Flowing
        </span>
      `;
    }
    if (item.analysisState === 'loading') {
      return `
        <span class="inline-flex items-center gap-2 rounded-lg border border-blue-200 bg-blue-50 px-3 py-2 text-xs font-semibold text-blue-700">
          <i class="fa-solid fa-spinner animate-spin"></i>
          Analyzing
        </span>
      `;
    }
    if (item.analysisState === 'done') {
      return `
        <span class="inline-flex items-center gap-2 rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-2 text-xs font-semibold text-emerald-700">
          <i class="fa-solid fa-circle-check"></i>
          Done
        </span>
      `;
    }
    if (item.analysisState === 'error') {
      return `
        <button data-analyze-tx="${escapeAttr(item.txHash)}" class="inline-flex items-center gap-2 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-xs font-semibold text-red-700 hover:bg-red-100">
          <i class="fa-solid fa-rotate-right"></i>
          Retry
        </button>
      `;
    }
    return `
      <button data-analyze-tx="${escapeAttr(item.txHash)}" class="inline-flex items-center gap-2 rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs font-bold text-slate-700 hover:border-secondary hover:text-secondary">
        <i class="fa-solid fa-circle-play text-secondary"></i>
        go
      </button>
    `;
  }

  function analysisPanel(item) {
    if (item.analysisState === 'idle' && item.fundFlowState === 'idle') return '';
    const isError = item.analysisState === 'error';
    const borderClass = isError ? 'border-red-100 bg-red-50 text-red-700' : 'border-blue-100 bg-blue-50 text-slate-700';
    const title = isError ? 'Analysis Failed' : 'AI Analysis Result';
    const analysisContent = item.analysisState === 'loading'
      ? '<div class="flex items-center gap-2 text-blue-700"><i class="fa-solid fa-spinner animate-spin"></i>正在结合资金流向与链上证据进行 AI 分析...</div>'
      : `<div class="max-h-[460px] overflow-y-auto whitespace-pre-wrap pr-2">${escapeHtml(item.analysisText)}</div>`;
    return `
      <div class="border-t border-slate-100 px-4 pb-5">
        ${fundFlowPanel(item)}
        <div class="rounded-lg border ${borderClass} p-4 text-sm leading-6">
          <div class="mb-2 flex items-center gap-2 font-bold">
            <i class="fa-solid ${isError ? 'fa-circle-exclamation' : 'fa-brain'}"></i>
            ${title}
          </div>
          ${analysisContent}
        </div>
      </div>
    `;
  }

  function fundFlowPanel(item) {
    if (item.fundFlowState === 'idle') return '';
    if (item.fundFlowState === 'loading') {
      return `
        <div class="mb-4 rounded-lg border border-slate-200 bg-slate-50 p-4">
          <div class="flex items-center gap-2 text-sm font-semibold text-slate-600">
            <i class="fa-solid fa-spinner animate-spin text-secondary"></i>
            正在根据交易哈希生成资金流向图...
          </div>
        </div>
      `;
    }
    if (!item.fundFlowData || !item.fundFlowData.displayable) {
      return `
        <div class="mb-4 rounded-lg border border-dashed border-slate-300 bg-white px-4 py-5 text-center text-sm font-semibold text-slate-500">
          ${escapeHtml(item.fundFlowMessage || '当前hash无法展示资金流向。')}
        </div>
      `;
    }
    return renderTransactionFundFlow(item.fundFlowData);
  }

  async function analyzeRecord(txHash) {
    const item = currentRecords.find((record) => record.txHash === txHash);
    if (!item) return;

    item.analysisState = 'loading';
    item.analysisText = '';
    item.fundFlowState = 'loading';
    item.fundFlowData = null;
    item.fundFlowMessage = '';
    renderFilteredRecords();

    try {
      const fundFlowData = await loadRecordFundFlow(item);
      item.fundFlowData = fundFlowData;
      item.fundFlowState = fundFlowData.displayable ? 'done' : 'unavailable';
      item.fundFlowMessage = fundFlowData.message || '当前hash无法展示资金流向。';
      renderFilteredRecords();

      const response = await fetch('/records/analyze', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          txHash: item.txHash,
          blockNum: item.blockNum,
          from: item.from,
          to: item.to,
          detectTime: item.detectTime,
          sourcePath: item.sourcePath,
          txUrl: item.txUrl,
          fundFlowData,
        }),
      });
      const data = await response.json();
      if (!response.ok || data.status !== 'ok') {
        throw new Error(data.message || '分析接口调用失败');
      }
      item.analysisState = 'done';
      item.analysisText = data.analysis || '未返回分析内容';
    } catch (error) {
      item.analysisState = 'error';
      item.analysisText = error.message;
    }

    renderFilteredRecords();
  }

  async function loadRecordFundFlow(item) {
    try {
      const response = await fetch('/fundflow/' + encodeURIComponent(item.txHash), { cache: 'no-store' });
      const data = await response.json();
      if (!response.ok) {
        return { status: 'error', displayable: false, txHash: item.txHash, message: data.message || '当前hash无法展示资金流向。' };
      }
      return data;
    } catch (error) {
      return { status: 'error', displayable: false, txHash: item.txHash, message: '当前hash无法展示资金流向。', detail: error.message };
    }
  }

  const FUND_FLOW_GRAPH_BASE_WIDTH = 1540;
  const FUND_FLOW_GRAPH_HEIGHT = 720;
  const FUND_FLOW_NODE_WIDTH = 172;
  const FUND_FLOW_NODE_HEIGHT = 44;
  const FUND_FLOW_NODE_CLEARANCE = 18;
  const FUND_FLOW_EDGE_STUB = 72;
  const FUND_FLOW_BOUNDARY_PADDING = 36;

  function renderTransactionFundFlow(data) {
    const nodesByAddress = new Map((data.nodes || []).map((node) => [String(node.address || '').toLowerCase(), node]));
    const visibleEdges = (data.edges || []).slice(0, 13).map((edge, index) => ({
      ...edge,
      from: String(edge.from || '').toLowerCase(),
      to: String(edge.to || '').toLowerCase(),
      color: graphFlowEdgeColor(edge, index),
    }));
    if (!visibleEdges.length) {
      return '<div class="mb-4 rounded-lg border border-dashed border-slate-300 bg-white px-4 py-5 text-center text-sm font-semibold text-slate-500">当前hash无法展示资金流向。</div>';
    }

    const graph = layoutBlocksecGraph(visibleEdges, nodesByAddress);
    const routes = planBlocksecGraphRoutes(visibleEdges, graph.positions, graph.width);
    const markerPrefix = 'txGraphArrow' + String(data.txHash || '').replace(/[^a-zA-Z0-9]/g, '').slice(0, 16);
    const markerSvg = visibleEdges.map((edge, index) => `
      <marker id="${markerPrefix}${index}" markerWidth="6" markerHeight="6" refX="5" refY="1.75" orient="auto" markerUnits="strokeWidth">
        <path d="M0,0 L0,3.5 L5,1.75 z" fill="${edge.color}"></path>
      </marker>
    `).join('');
    const edgeSvg = visibleEdges.map((edge, index) => renderBlocksecGraphEdge(edge, index, graph.positions, routes[index], markerPrefix, graph.width)).join('');
    const nodeSvg = graph.nodes.map((node) => renderBlocksecGraphNode(node)).join('');
    const graphSvg = `
      <svg viewBox="0 0 ${graph.width} ${FUND_FLOW_GRAPH_HEIGHT}" width="${graph.width}" height="${FUND_FLOW_GRAPH_HEIGHT}" class="h-auto w-full" preserveAspectRatio="xMidYMid meet">
        <defs>
          <filter id="txNodeShadow" x="-30%" y="-30%" width="160%" height="160%">
            <feDropShadow dx="0" dy="2" stdDeviation="2.4" flood-color="#0f172a" flood-opacity="0.08"></feDropShadow>
          </filter>
          ${markerSvg}
        </defs>
        <rect x="0" y="0" width="${graph.width}" height="${FUND_FLOW_GRAPH_HEIGHT}" rx="12" fill="#FFFFFF" />
        ${edgeSvg}
        ${nodeSvg}
      </svg>
    `;

    return `
      <div class="mb-4 rounded-lg border border-slate-200 bg-slate-50/80 p-3">
        <div class="mb-3 flex items-center gap-2 border-b border-slate-100 pb-2 text-sm font-bold text-slate-800">
          <span class="inline-flex h-7 w-7 items-center justify-center rounded-md border border-slate-200 bg-white text-slate-600">
            <i class="fa-solid fa-bars"></i>
          </span>
          资金流向
        </div>
        <div class="relative overflow-hidden rounded-xl border border-slate-200 bg-white" data-fund-flow-graph="${escapeAttr(data.txHash || '')}">
          <button type="button" data-flow-action="expand" data-flow-tx="${escapeAttr(data.txHash || '')}" class="absolute right-3 top-3 z-10 inline-flex h-9 w-9 items-center justify-center rounded-md border border-slate-200 bg-white text-slate-600 shadow-sm hover:border-blue-300 hover:text-secondary" title="悬浮展示资金流图" aria-label="悬浮展示资金流图">
            <i class="fa-solid fa-up-right-and-down-left-from-center text-sm"></i>
          </button>
          <button type="button" data-flow-action="download" data-flow-tx="${escapeAttr(data.txHash || '')}" class="absolute right-3 top-14 z-10 inline-flex h-9 w-9 items-center justify-center rounded-md border border-slate-200 bg-white text-slate-600 shadow-sm hover:border-emerald-300 hover:text-emerald-600" title="下载资金流向图" aria-label="下载资金流向图">
            <i class="fa-solid fa-download text-sm"></i>
          </button>
          ${graphSvg}
        </div>
        ${data.truncated ? '<div class="mt-2 text-xs text-slate-500">仅展示前 13 条资金边。</div>' : ''}
      </div>
    `;
  }

  function bindFundFlowButtons() {
    document.querySelectorAll('[data-flow-action]').forEach((button) => {
      button.addEventListener('click', () => {
        const txHash = button.dataset.flowTx;
        const item = currentRecords.find((record) => record.txHash === txHash);
        if (!item?.fundFlowData?.displayable) return;
        const wrapper = button.closest('[data-fund-flow-graph]');
        const graphSvg = wrapper?.querySelector('svg')?.outerHTML || '';
        if (!graphSvg) return;
        button.dataset.flowAction === 'expand'
          ? openFundFlowPopup(graphSvg)
          : downloadFundFlowImage(graphSvg, txHash);
      });
    });
  }

  function layoutBlocksecGraph(edges, nodesByAddress) {
    const addressSet = new Set();
    edges.forEach((edge) => {
      addressSet.add(edge.from);
      addressSet.add(edge.to);
    });
    const addresses = [...addressSet];
    const degree = new Map(addresses.map((address) => [address, { in: 0, out: 0 }]));
    edges.forEach((edge) => {
      degree.get(edge.from).out += 1;
      degree.get(edge.to).in += 1;
    });

    const sourceNodes = addresses.filter((address) => degree.get(address).out > 0 && degree.get(address).in === 0);
    const middleNodes = addresses.filter((address) => degree.get(address).in > 0 && degree.get(address).out > 0);
    const sinkNodes = addresses.filter((address) => degree.get(address).in > 0 && degree.get(address).out === 0);
    const orphanNodes = addresses.filter((address) => degree.get(address).in === 0 && degree.get(address).out === 0);
    const columns = buildGraphPriorityColumns(sourceNodes, middleNodes, sinkNodes, orphanNodes, degree);

    if (!columns.length && addresses.length) {
      columns.push({ role: 'middle', addresses: orderGraphColumn(addresses, degree), priority: 0 });
    }

    const columnGaps = estimateGraphColumnGaps(edges, columns);
    const width = estimateGraphWidth(columnGaps);
    const maxColumnSize = Math.max(...columns.map((column) => column.addresses.length), 1);
    const verticalGap = maxColumnSize <= 1 ? 0 : Math.min(88, (FUND_FLOW_GRAPH_HEIGHT - 140) / (maxColumnSize - 1));
    const columnXs = distributeGraphColumnXs(columns, width, columnGaps);
    const positions = new Map();

    columns.forEach((column, index) => {
      placeGraphColumn(positions, column.addresses, nodesByAddress, degree, columnXs[index], verticalGap, column.role);
    });
    adjustGraphBoundaryColumns(edges, positions, width);

    return { width, positions, nodes: [...positions.values()] };
  }

  function estimateGraphColumnGaps(edges, columns) {
    if (columns.length <= 1) return [];
    const addressColumn = new Map();
    columns.forEach((column, columnIndex) => {
      column.addresses.forEach((address) => addressColumn.set(address, columnIndex));
    });

    const gaps = Array.from({ length: columns.length - 1 }, () => 320);
    edges.forEach((edge, index) => {
      const fromColumn = addressColumn.get(edge.from);
      const toColumn = addressColumn.get(edge.to);
      if (fromColumn === undefined || toColumn === undefined || fromColumn === toColumn) return;
      const minColumn = Math.min(fromColumn, toColumn);
      const maxColumn = Math.max(fromColumn, toColumn);
      const labelWidth = estimateTextWidth(graphEdgeLabel(edge, index), 11);
      const requiredGap = Math.min(560, Math.max(320, labelWidth + 240));
      for (let gapIndex = minColumn; gapIndex < maxColumn; gapIndex += 1) {
        gaps[gapIndex] = Math.max(gaps[gapIndex], requiredGap);
      }
    });
    return gaps;
  }

  function estimateGraphWidth(columnGaps) {
    if (!columnGaps.length) return FUND_FLOW_GRAPH_BASE_WIDTH;
    const neededWidth = 300 + columnGaps.reduce((sum, gap) => sum + gap, 0);
    return Math.ceil(Math.max(FUND_FLOW_GRAPH_BASE_WIDTH, Math.min(2400, neededWidth)));
  }

  function estimateTextWidth(text, fontSize) {
    return String(text || '').length * fontSize * 0.62 + 24;
  }

  function buildGraphPriorityColumns(sourceNodes, middleNodes, sinkNodes, orphanNodes, degree) {
    const columns = [];
    if (sourceNodes.length) {
      columns.push({ role: 'source', addresses: orderGraphColumn(sourceNodes, degree), priority: Number.POSITIVE_INFINITY });
    }

    const middleGroups = new Map();
    middleNodes.forEach((address) => {
      const priority = graphNodePriority(address, degree);
      if (!middleGroups.has(priority)) middleGroups.set(priority, []);
      middleGroups.get(priority).push(address);
    });

    [...middleGroups.entries()]
      .sort((left, right) => right[0] - left[0])
      .forEach(([priority, group]) => {
        columns.push({ role: 'middle', addresses: orderGraphColumn(group, degree), priority });
      });

    if (orphanNodes.length) {
      columns.push({ role: 'middle', addresses: orderGraphColumn(orphanNodes, degree), priority: 0 });
    }
    if (sinkNodes.length) {
      columns.push({ role: 'sink', addresses: orderGraphColumn(sinkNodes, degree), priority: Number.NEGATIVE_INFINITY });
    }
    return columns;
  }

  function graphNodePriority(address, degree) {
    const metrics = degree.get(address) || { in: 0, out: 0 };
    return metrics.in + metrics.out;
  }

  function orderGraphColumn(addresses, degree) {
    return addresses.slice().sort((left, right) => {
      const leftDegree = degree.get(left) || { in: 0, out: 0 };
      const rightDegree = degree.get(right) || { in: 0, out: 0 };
      const byConnectivity = (rightDegree.in + rightDegree.out) - (leftDegree.in + leftDegree.out);
      if (byConnectivity !== 0) return byConnectivity;
      return left.localeCompare(right);
    });
  }

  function distributeGraphColumnXs(columns, graphWidth, columnGaps) {
    if (columns.length <= 1) return [graphWidth / 2];
    const usedWidth = 300 + columnGaps.reduce((sum, gap) => sum + gap, 0);
    const extraGap = Math.max(0, graphWidth - usedWidth) / columnGaps.length;
    const xs = [150];
    columnGaps.forEach((gap) => {
      xs.push(xs[xs.length - 1] + gap + extraGap);
    });
    return xs;
  }

  function placeGraphColumn(positions, addresses, nodesByAddress, degree, x, verticalGap, role) {
    if (!addresses.length) return;
    const startY = FUND_FLOW_GRAPH_HEIGHT / 2 - ((addresses.length - 1) * verticalGap) / 2;
    addresses.forEach((address, index) => {
      const y = Math.max(46, Math.min(FUND_FLOW_GRAPH_HEIGHT - 46, startY + index * verticalGap));
      positions.set(address, graphNode(address, nodesByAddress, degree, x, y, role));
    });
  }

  function adjustGraphBoundaryColumns(edges, positions, graphWidth) {
    const bounds = graphRouteBounds(edges, positions);
    if (!bounds) return;

    const leftOverflow = Math.max(0, FUND_FLOW_BOUNDARY_PADDING - bounds.minX);
    const rightOverflow = Math.max(0, bounds.maxX - (graphWidth - FUND_FLOW_BOUNDARY_PADDING));
    if (leftOverflow <= 0 && rightOverflow <= 0) return;

    if (leftOverflow > 0) {
      shiftGraphRole(positions, 'source', Math.min(leftOverflow, maxGraphRoleShift(positions, 'source', 1)));
    }
    if (rightOverflow > 0) {
      shiftGraphRole(positions, 'sink', -Math.min(rightOverflow, maxGraphRoleShift(positions, 'sink', -1)));
    }
  }

  function graphRouteBounds(edges, positions) {
    let minX = Number.POSITIVE_INFINITY;
    let maxX = Number.NEGATIVE_INFINITY;

    edges.forEach((edge) => {
      const from = positions.get(edge.from);
      const to = positions.get(edge.to);
      if (!from || !to) return;
      const ports = graphEdgePorts(from, to);
      const xs = [
        ports.start.x,
        ports.end.x,
        ports.start.x + ports.startDirection * FUND_FLOW_EDGE_STUB,
        ports.end.x + ports.endDirection * FUND_FLOW_EDGE_STUB,
      ];
      minX = Math.min(minX, ...xs);
      maxX = Math.max(maxX, ...xs);
    });

    if (!Number.isFinite(minX) || !Number.isFinite(maxX)) return null;
    return { minX, maxX };
  }

  function shiftGraphRole(positions, role, deltaX) {
    positions.forEach((node) => {
      if (node.role === role) {
        node.x += deltaX;
      }
    });
  }

  function maxGraphRoleShift(positions, role, direction) {
    const roleNodes = [...positions.values()].filter((node) => node.role === role);
    const otherNodes = [...positions.values()].filter((node) => node.role !== role);
    if (!roleNodes.length || !otherNodes.length) return Number.POSITIVE_INFINITY;

    if (direction > 0) {
      const roleRight = Math.max(...roleNodes.map((node) => node.x));
      const nearestRight = Math.min(...otherNodes.filter((node) => node.x > roleRight).map((node) => node.x));
      return Number.isFinite(nearestRight) ? Math.max(0, nearestRight - roleRight - 260) : Number.POSITIVE_INFINITY;
    }

    const roleLeft = Math.min(...roleNodes.map((node) => node.x));
    const nearestLeft = Math.max(...otherNodes.filter((node) => node.x < roleLeft).map((node) => node.x));
    return Number.isFinite(nearestLeft) ? Math.max(0, roleLeft - nearestLeft - 260) : Number.POSITIVE_INFINITY;
  }

  function graphNode(address, nodesByAddress, degree, x, y, role) {
    const metrics = degree.get(address) || { in: 0, out: 0 };
    return {
      ...(nodesByAddress.get(address) || {}),
      address,
      x,
      y,
      role,
      inDegree: metrics.in,
      outDegree: metrics.out,
      hasIncoming: metrics.in > 0,
      hasOutgoing: metrics.out > 0,
    };
  }

  function planBlocksecGraphRoutes(edges, positions) {
    const pairEdges = new Map();
    edges.forEach((edge, index) => {
      const key = `${edge.from}->${edge.to}`;
      if (!pairEdges.has(key)) pairEdges.set(key, []);
      pairEdges.get(key).push(index);
    });

    return edges.map((edge, index) => {
      const from = positions.get(edge.from);
      const to = positions.get(edge.to);
      if (!from || !to) return { laneY: FUND_FLOW_GRAPH_HEIGHT / 2, direct: false };
      const ports = graphEdgePorts(from, to);
      const start = ports.start;
      const end = ports.end;
      const pairKey = `${edge.from}->${edge.to}`;
      const siblings = pairEdges.get(pairKey) || [index];
      const siblingIndex = siblings.indexOf(index);
      const siblingOffset = (siblingIndex - (siblings.length - 1) / 2) * 14;
      const baseLaneY = (start.x <= end.x ? end.y : start.y) + siblingOffset;
      const exitX = start.x + ports.startDirection * FUND_FLOW_EDGE_STUB;
      const entryX = end.x + ports.endDirection * FUND_FLOW_EDGE_STUB;
      const firstSingleFlow = from.inDegree === 0 && from.outDegree === 1 && siblings.length === 1;

      return {
        laneY: resolveGraphLaneY(baseLaneY, exitX, entryX, positions, [edge.from, edge.to]),
        smooth: firstSingleFlow,
        direct: Math.abs(start.y - end.y) <= 2 && siblings.length === 1 && isGraphLaneClear(start.y, start.x, end.x, positions, [edge.from, edge.to]),
      };
    });
  }

  function clampGraphY(y) {
    return Math.max(42, Math.min(FUND_FLOW_GRAPH_HEIGHT - 42, y));
  }

  function resolveGraphLaneY(baseY, startX, endX, positions, excludedAddresses = []) {
    const candidates = [baseY];
    for (let offset = 18; offset <= 220; offset += 18) {
      candidates.push(baseY - offset, baseY + offset);
    }
    const fallbackCandidates = [...positions.values()].flatMap((node) => [
      node.y - FUND_FLOW_NODE_HEIGHT / 2 - FUND_FLOW_NODE_CLEARANCE,
      node.y + FUND_FLOW_NODE_HEIGHT / 2 + FUND_FLOW_NODE_CLEARANCE,
    ]);
    return [...candidates, ...fallbackCandidates]
      .map(clampGraphY)
      .sort((left, right) => Math.abs(left - baseY) - Math.abs(right - baseY))
      .find((candidateY) => isGraphLaneClear(candidateY, startX, endX, positions, excludedAddresses))
      ?? clampGraphY(baseY);
  }

  function isGraphLaneClear(y, startX, endX, positions, excludedAddresses = []) {
    const minX = Math.min(startX, endX);
    const maxX = Math.max(startX, endX);
    const excluded = new Set(excludedAddresses);
    return [...positions.values()].every((node) => {
      if (excluded.has(node.address)) return true;
      const nodeLeft = node.x - FUND_FLOW_NODE_WIDTH / 2 - FUND_FLOW_NODE_CLEARANCE;
      const nodeRight = node.x + FUND_FLOW_NODE_WIDTH / 2 + FUND_FLOW_NODE_CLEARANCE;
      const nodeTop = node.y - FUND_FLOW_NODE_HEIGHT / 2 - FUND_FLOW_NODE_CLEARANCE;
      const nodeBottom = node.y + FUND_FLOW_NODE_HEIGHT / 2 + FUND_FLOW_NODE_CLEARANCE;
      const crossesX = maxX >= nodeLeft && minX <= nodeRight;
      const crossesY = y >= nodeTop && y <= nodeBottom;
      return !(crossesX && crossesY);
    });
  }

  function renderBlocksecGraphEdge(edge, index, positions, route, markerPrefix) {
    const from = positions.get(edge.from);
    const to = positions.get(edge.to);
    if (!from || !to) return '';
    const { start, end, startDirection, endDirection } = graphEdgePorts(from, to);
    const laneY = route?.laneY ?? Math.round((from.y + to.y) / 2);
    const exitX = start.x + startDirection * FUND_FLOW_EDGE_STUB;
    const entryX = end.x + endDirection * FUND_FLOW_EDGE_STUB;
    const curve = route?.smooth
      ? renderSmoothGraphPath(start, end)
      : route?.direct
      ? `M ${start.x} ${start.y} L ${end.x} ${end.y}`
      : renderLayerLaneGraphPath(start, end, exitX, entryX, laneY, startDirection, endDirection);
    const labelX = route?.smooth || route?.direct ? (start.x + end.x) / 2 : (Math.min(exitX, entryX) + Math.max(exitX, entryX)) / 2;
    const labelY = (route?.smooth || route?.direct ? (start.y + end.y) / 2 : laneY) - 8;
    const label = graphEdgeLabel(edge, index);
    return `
      <g>
        <path d="${curve}" fill="none" stroke="${edge.color}" stroke-width="2.4" marker-end="url(#${markerPrefix}${index})" opacity="0.96" />
        <text x="${labelX}" y="${labelY}" text-anchor="middle" font-size="11" font-weight="650" stroke="#ffffff" stroke-width="4" paint-order="stroke" fill="${edge.color}">${escapeHtml(label)}</text>
      </g>
    `;
  }

  function graphEdgeLabel(edge, index) {
    return `[${index + 1}] ${edge.amount || '-'} ${edge.asset || ''}`.trim();
  }

  function renderSmoothGraphPath(start, end) {
    const direction = end.x >= start.x ? 1 : -1;
    const controlOffset = Math.min(260, Math.max(110, Math.abs(end.x - start.x) * 0.42));
    return [
      `M ${start.x} ${start.y}`,
      `C ${start.x + direction * controlOffset} ${start.y}, ${end.x - direction * controlOffset} ${end.y}, ${end.x} ${end.y}`
    ].join(' ');
  }

  function renderLayerLaneGraphPath(start, end, exitX, entryX, laneY, startDirection, endDirection) {
    const startDelta = Math.abs(laneY - start.y);
    const endDelta = Math.abs(end.y - laneY);
    const startRadius = Math.min(24, Math.max(0, startDelta / 2));
    const endRadius = Math.min(24, Math.max(0, endDelta / 2));
    const laneDirection = entryX >= exitX ? 1 : -1;
    const startTurn = laneY >= start.y ? 1 : -1;
    const endTurn = end.y >= laneY ? 1 : -1;
    const commands = [`M ${start.x} ${start.y}`];

    if (startRadius > 0) {
      commands.push(`L ${exitX - startDirection * startRadius} ${start.y}`);
      commands.push(`Q ${exitX} ${start.y} ${exitX} ${start.y + startTurn * startRadius}`);
      commands.push(`L ${exitX} ${laneY - startTurn * startRadius}`);
      commands.push(`Q ${exitX} ${laneY} ${exitX + laneDirection * startRadius} ${laneY}`);
    } else {
      commands.push(`L ${exitX} ${laneY}`);
    }

    if (endRadius > 0) {
      commands.push(`L ${entryX - laneDirection * endRadius} ${laneY}`);
      commands.push(`Q ${entryX} ${laneY} ${entryX} ${laneY + endTurn * endRadius}`);
      commands.push(`L ${entryX} ${end.y - endTurn * endRadius}`);
      commands.push(`Q ${entryX} ${end.y} ${entryX - endDirection * endRadius} ${end.y}`);
    } else {
      commands.push(`L ${entryX} ${laneY}`);
    }

    commands.push(`L ${end.x} ${end.y}`);
    return commands.join(' ');
  }

  function graphEdgePorts(from, to) {
    const candidates = [
      { start: graphNodePort(from, 'out', 1), end: graphNodePort(to, 'in', -1), startDirection: 1, endDirection: -1 },
      { start: graphNodePort(from, 'out', -1), end: graphNodePort(to, 'in', 1), startDirection: -1, endDirection: 1 },
      { start: graphNodePort(from, 'out', 1), end: graphNodePort(to, 'in', 1), startDirection: 1, endDirection: 1 },
      { start: graphNodePort(from, 'out', -1), end: graphNodePort(to, 'in', -1), startDirection: -1, endDirection: -1 },
    ];

    return candidates.sort((left, right) => {
      const leftDistance = Math.abs(left.end.x - left.start.x) + Math.abs(left.end.y - left.start.y);
      const rightDistance = Math.abs(right.end.x - right.start.x) + Math.abs(right.end.y - right.start.y);
      return leftDistance - rightDistance;
    })[0];
  }

  function graphNodePort(node, type, side) {
    const offsetY = type === 'in' ? -FUND_FLOW_NODE_HEIGHT * 0.22 : FUND_FLOW_NODE_HEIGHT * 0.22;
    return {
      x: node.x + side * (FUND_FLOW_NODE_WIDTH / 2),
      y: node.y + offsetY,
    };
  }

  function renderBlocksecGraphNode(node) {
    const isSource = node.role === 'source';
    const isSink = node.role === 'sink';
    const isMiddle = node.role === 'middle';
    const fill = isSource ? '#EEF3F8' : isMiddle ? '#BFDDF7' : isSink ? '#FDE2E2' : '#EEF3F8';
    const name = isMiddle ? 'Contract / Router' : isSink ? 'Receiver' : node.outDegree > 0 ? 'Sender' : 'Address';
    return `
      <g filter="url(#txNodeShadow)">
        <rect x="${node.x - FUND_FLOW_NODE_WIDTH / 2}" y="${node.y - FUND_FLOW_NODE_HEIGHT / 2}" width="${FUND_FLOW_NODE_WIDTH}" height="${FUND_FLOW_NODE_HEIGHT}" rx="6" fill="${fill}" />
        <circle cx="${node.x - 70}" cy="${node.y}" r="10" fill="#2F3A45"></circle>
        <path d="M ${node.x - 70} ${node.y - 7} L ${node.x - 75} ${node.y} L ${node.x - 70} ${node.y + 4} L ${node.x - 65} ${node.y} Z" fill="#F8FAFC"></path>
        <path d="M ${node.x - 75} ${node.y + 2} L ${node.x - 70} ${node.y + 8} L ${node.x - 65} ${node.y + 2} L ${node.x - 70} ${node.y + 5} Z" fill="#CBD5E1"></path>
        <text x="${node.x - 52}" y="${node.y - 6}" font-size="11" font-weight="700" fill="#475569">${escapeHtml(name)}</text>
        <text x="${node.x - 52}" y="${node.y + 12}" font-size="11" fill="#7A8796">${escapeHtml(shortAddress(node.address))}</text>
      </g>
    `;
  }

  function graphFlowEdgeColor(edge, index) {
    const palette = ['#1D4A9B', '#2F78FF', '#14A7E8', '#09B8D9', '#8B5CF6', '#A855F7', '#FF8A00', '#B86A00', '#C084FC', '#F59E0B', '#0F5B6E', '#8B4513', '#9A3412'];
    return palette[index % palette.length];
  }

  function openFundFlowPopup(graphSvg) {
    let modal = document.getElementById('fundFlowPopup');
    if (!modal) {
      document.body.insertAdjacentHTML('beforeend', `
        <div id="fundFlowPopup" class="fixed inset-0 z-[100] hidden bg-slate-950/70 p-4 backdrop-blur-sm">
          <div class="mx-auto flex h-full max-w-[96vw] flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-2xl">
            <div class="flex items-center justify-between border-b border-slate-200 px-4 py-3">
              <div class="flex items-center gap-2 text-sm font-bold text-slate-800">
                <span class="inline-flex h-7 w-7 items-center justify-center rounded-md border border-slate-200 bg-white text-slate-600">
                  <i class="fa-solid fa-bars"></i>
                </span>
                资金流向
              </div>
              <button type="button" class="fund-flow-popup-close inline-flex h-8 w-8 items-center justify-center rounded-md border border-slate-200 text-slate-600 hover:border-red-200 hover:text-red-500" aria-label="关闭资金流图">
                <i class="fa-solid fa-xmark"></i>
              </button>
            </div>
            <div class="fund-flow-popup-body flex-1 overflow-auto bg-white"></div>
          </div>
        </div>
      `);
      modal = document.getElementById('fundFlowPopup');
      modal.querySelector('.fund-flow-popup-close').addEventListener('click', closeFundFlowPopup);
      modal.addEventListener('click', (event) => {
        if (event.target === modal) closeFundFlowPopup();
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeFundFlowPopup();
      });
    }

    modal.querySelector('.fund-flow-popup-body').innerHTML = graphSvg.replace('class="h-auto w-full"', 'class="h-auto max-w-none"');
    modal.classList.remove('hidden');
    document.body.classList.add('overflow-hidden');
  }

  function closeFundFlowPopup() {
    const modal = document.getElementById('fundFlowPopup');
    if (!modal) return;
    modal.classList.add('hidden');
    document.body.classList.remove('overflow-hidden');
  }

  function downloadFundFlowImage(graphSvg, txHash) {
    const svgDocument = new DOMParser().parseFromString(graphSvg, 'image/svg+xml');
    const svg = svgDocument.documentElement;
    const width = Number(svg.getAttribute('width')) || FUND_FLOW_GRAPH_BASE_WIDTH;
    const height = Number(svg.getAttribute('height')) || FUND_FLOW_GRAPH_HEIGHT;
    const serializedSvg = new XMLSerializer().serializeToString(svg);
    const svgBlob = new Blob([serializedSvg], { type: 'image/svg+xml;charset=utf-8' });
    const svgUrl = URL.createObjectURL(svgBlob);
    const image = new Image();

    image.onload = () => {
      const canvas = document.createElement('canvas');
      canvas.width = width;
      canvas.height = height;
      const context = canvas.getContext('2d');
      context.fillStyle = '#ffffff';
      context.fillRect(0, 0, width, height);
      context.drawImage(image, 0, 0, width, height);
      URL.revokeObjectURL(svgUrl);
      canvas.toBlob((blob) => {
        if (!blob) {
          downloadBlob(svgBlob, fundFlowDownloadName(txHash, 'svg'));
          return;
        }
        downloadBlob(blob, fundFlowDownloadName(txHash, 'png'));
      }, 'image/png');
    };

    image.onerror = () => {
      URL.revokeObjectURL(svgUrl);
      downloadBlob(svgBlob, fundFlowDownloadName(txHash, 'svg'));
    };

    image.src = svgUrl;
  }

  function downloadBlob(blob, filename) {
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = filename;
    document.body.appendChild(link);
    link.click();
    link.remove();
    setTimeout(() => URL.revokeObjectURL(url), 0);
  }

  function fundFlowDownloadName(txHash, ext) {
    const shortHash = String(txHash || 'graph').replace(/[^a-zA-Z0-9]/g, '').slice(0, 16) || 'graph';
    return `fund-flow-${shortHash}.${ext}`;
  }

  function addressLink(address, url) {
    if (!address) return '<span class="text-slate-400">-</span>';
    return `<a href="${escapeAttr(url)}" target="_blank" class="block font-mono text-secondary hover:underline hash-text" title="${escapeAttr(address)}">${shortAddress(address)}</a>`;
  }

  function showBanner(message, type) {
    statusBanner.className = type === 'error'
      ? 'mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-600'
      : 'mb-4 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-700';
    statusBanner.textContent = message;
  }

  function hideBanner() {
    statusBanner.className = 'hidden mb-4 rounded-lg border px-4 py-3 text-sm';
    statusBanner.textContent = '';
  }

  function shortHash(value) {
    if (!value) return '-';
    return value.length > 20 ? value.slice(0, 10) + '...' + value.slice(-8) : value;
  }

  function shortAddress(value) {
    if (!value) return '-';
    return value.length > 18 ? value.slice(0, 8) + '...' + value.slice(-6) : value;
  }

  function formatDateTime(value) {
    if (!value) return '-';
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return value;
    return date.toLocaleString('zh-CN', { hour12: false });
  }

  function formatAge(value) {
    if (!value) return '-';
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return value;
    const seconds = Math.max(0, Math.floor((Date.now() - date.getTime()) / 1000));
    if (seconds < 60) return seconds + ' secs ago';
    if (seconds < 3600) return Math.floor(seconds / 60) + ' mins ago';
    if (seconds < 86400) return Math.floor(seconds / 3600) + ' hrs ago';
    return date.toLocaleString('zh-CN', { hour12: false });
  }

  function escapeHtml(value) {
    return String(value)
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#039;');
  }

  function escapeAttr(value) {
    return escapeHtml(value || '');
  }
</script>
</body>
</html>
