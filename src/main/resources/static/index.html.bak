    <script>
      // 展开/收起逻辑
      document.querySelectorAll('button').forEach(btn => {
        btn.addEventListener('click', () => {
          const content = btn.closest('div').querySelector('.mt-4');
          const arrow = btn.querySelector('svg');
          content.classList.toggle('hidden');
          arrow.classList.toggle('rotate-180');
        });
      });

      // 全局数据配置
      let dataList = [];
      let totalCount = 0;
      let totalMoney = 0;

      // 1. 页面加载主逻辑
document.addEventListener('DOMContentLoaded', async () => {
  try {
    const response = await fetch('./excel/merged_v1.xlsx');
    const buffer = await response.arrayBuffer();
    const workbook = XLSX.read(buffer, { type: 'array' });
    const worksheet = workbook.Sheets[workbook.SheetNames[0]];
    const rows = XLSX.utils.sheet_to_json(worksheet, { header: 1 });

    // 处理数据
    dataList = rows.slice(1).filter(row => row && row.length > 0);

    // 【关键】只调用现有的渲染函数，删除了对不存在 DOM 的操作
    renderPieChart();
    renderLatestEvents();
  } catch (error) {
    console.error('数据加载或渲染失败：', error);
  }
});

function parseExcelDate(value) {
  if (!value || value === '-') return null;
  if (!isNaN(value)) {
    const date = new Date((value - 25569) * 86400 * 1000);
    return isNaN(date.getTime()) ? null : date;
  }
  const parsed = new Date(value);
  return isNaN(parsed.getTime()) ? null : parsed;
}

function formatExcelDate(value) {
  const parsed = parseExcelDate(value);
  if (!parsed) return value || '-';
  return parsed.toLocaleDateString('zh-CN');
}

function renderLatestEvents() {
  const container = document.getElementById('latest_events');
  if (!container) return;

  const sorted = [...dataList].sort((a, b) => {
    const dateA = parseExcelDate(a[0]);
    const dateB = parseExcelDate(b[0]);
    return (dateB ? dateB.getTime() : 0) - (dateA ? dateA.getTime() : 0);
  });

  const latest = sorted.slice(0, 4);
  if (latest.length === 0) {
    container.innerHTML = '<div class="rounded-xl border border-dashed border-gray-300 bg-white/60 p-6 text-center text-sm text-gray-500">暂无攻击事件数据</div>';
    return;
  }

  container.innerHTML = latest.map((row, index) => {
    const time = formatExcelDate(row[0]);
    const project = row[1] || '-';
    const desc = row[2] || '-';
    const loss = row[3] || '-';
    const attack = row[4] || '-';
    const link = row[5] || '#';
    const source = row[6] || '-';

    return `
      <div class="group rounded-xl border border-gray-200 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:shadow-md">
        <div class="flex items-center justify-between text-xs text-gray-500">
          <span class="inline-flex items-center gap-2 rounded-full bg-gray-100 px-2.5 py-1 text-gray-600">
            最新 ${index + 1}
          </span>
          <span>${time}</span>
        </div>
        <h4 class="mt-4 text-lg font-semibold text-gray-900">${project}</h4>
        <p class="mt-2 text-sm text-gray-600">${desc}</p>
        <div class="mt-4 flex flex-wrap items-center gap-3 text-xs text-gray-500">
          <span>损失金额：$${loss}</span>
          <span>攻击手法：${attack}</span>
        </div>
        <div class="mt-3 text-xs text-gray-500">数据来源：${source}</div>
        <a href="${link}" target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-secondary hover:text-secondary/80 transition-colors">
          查看参考来源
          <i class="fa-solid fa-arrow-up-right-from-square text-xs"></i>
        </a>
      </div>
    `;
  }).join('');
}

function renderPieChart() {
  Chart.register(ChartDataLabels);
  const typeData = {};
  
  // 1. 数据统计
  dataList.forEach(row => {
    const type = row[4] || '未知攻击';
    typeData[type] = (typeData[type] || 0) + 1;
  });

  const sorted = Object.entries(typeData).sort((a, b) => b[1] - a[1]);
  const top8 = sorted.slice(0, 8);
  const rest = sorted.slice(8);
  const otherCount = rest.reduce((sum, item) => sum + item[1], 0);

  const labels = [];
  const values = [];
  top8.forEach(([k, v]) => { labels.push(k); values.push(v); });
  if (otherCount > 0) { labels.push('其他'); values.push(otherCount); }

  const total = values.reduce((acc, val) => acc + val, 0);
  const colors = ['#3B82F6','#10B981','#F59E0B','#EF4444','#8B5CF6','#06B6D4','#F43F5E','#84CC16','#475569'];

  // *** 核心新增：中心文字插件 ***
  const centerTextPlugin = {
    id: 'centerText',
    beforeDraw: (chart) => {
      const { ctx, width, height } = chart;
      ctx.save();
      const fontSize = (height / 300).toFixed(2);
      ctx.font = `bold ${fontSize}em sans-serif`;
      ctx.textBaseline = 'middle';
      ctx.textAlign = 'center';
      ctx.fillStyle = '#374151'; // 灰黑色文字
      
      const text = "攻击事件展示";
      const textX = width / 2;
      const textY = height / 2;
      
      ctx.fillText(text, textX, textY);
      ctx.restore();
    }
  };

  if (window.attackChartInstance) window.attackChartInstance.destroy();

  const ctx = document.getElementById('attack_pie').getContext('2d');
  window.attackChartInstance = new Chart(ctx, {
    type: 'doughnut',
    data: { 
      labels, 
      datasets: [{ 
        data: values, 
        backgroundColor: colors, 
        borderWidth: 0,
        hoverOffset: 15
      }] 
    },
    plugins: [centerTextPlugin], // *** 注册中心文字插件 ***
    options: {
      responsive: true,
      maintainAspectRatio: false,
      cutout: '72%', // 稍微增加中心圆空隙，让文字更透气
      plugins: {
        legend: { display: false },
        datalabels: {
          color: '#fff',
          font: { weight: 'bold', size: 11 },
          formatter: (val) => {
            const percentage = ((val/total)*100).toFixed(1);
            return percentage > 4 ? percentage + '%' : null;
          }
        }
      }
    }
  });
  
  // 5. 动态渲染自定义并排图例
  const legendContainer = document.getElementById('custom_legend');
  if (legendContainer) {
    legendContainer.innerHTML = labels.map((label, i) => `
      <div class="flex items-center gap-2 flex-shrink-0">
        <span class="w-3 h-3 rounded-full" style="background-color: ${colors[i]}"></span>
        <span class="text-sm text-gray-600 font-medium whitespace-nowrap">${label}</span>
      </div>
    `).join('');
  }
}
    </script>
  </div>
</section>

